        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class=&#34;brainhack-symposium-mark&#34; aria-label=&#34;BrainHack School Taiwan Singapore&#34;&gt;
      &lt;img src=&#34;https://clinicalbrainlab.github.io/media/brainhack/bhs-taiwan-singapore-transparent.png&#34; alt=&#34;BrainHack School Taiwan x Singapore logo&#34;&gt;
